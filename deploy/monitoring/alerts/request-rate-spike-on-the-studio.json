{
  "displayName": "Polson — request rate spike on the studio",
  "combiner": "OR",
  "conditions": [
    {
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"SERVICE_NAME\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ]
      },
      "displayName": "> 2 requests/sec over 5 min"
    }
  ],
  "documentation": {
    "content": "Requests to the Cloud Run service, whether or not they reach an agent. Catches scraping or enumeration that the turn-based alerts would never see.",
    "mimeType": "text/markdown"
  },
  "notificationChannels": [
    "NOTIFICATION_CHANNEL"
  ],
  "enabled": true
}
