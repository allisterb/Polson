<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polson.Tests.Animation" />
    <InternalsVisibleTo Include="Polson.MCPServer" />
  </ItemGroup>

  <!-- Animation draws through both drawing projects; neither of them references this one, and that
       direction should stay one-way, as it does for Polson.Drawing.Mesh. -->
  <ItemGroup>
    <ProjectReference Include="..\Polson.Drawing.Skia\Polson.Drawing.Skia.csproj" />
    <ProjectReference Include="..\Polson.Drawing.Svg\Polson.Drawing.Svg.csproj" />
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
  </ItemGroup>

  <!-- The CMU Pronouncing Dictionary and its licence (BSD-style; see Speech/README.md), fetched into Speech/ by
       tools/bootstrap.py. Copied next to the assembly, and from there into every project that references this one. A
       build before the fetch still succeeds, and Motion.speech then says what is missing. -->
  <ItemGroup>
    <None Update="Speech\cmudict.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
