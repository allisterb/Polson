<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
    <!-- A method with a loop is compiled optimised from its first call rather than run as quick first-pass code until it
         tiers up. The engine's per-pixel work is all loops, and a script is short: becool1 measured grain at ~65 ms a
         frame at 1920 x 1080 in a probe and left it out of its film, where the same layer optimised takes 15-18 ms.
         Measured 2026-10-25: startup 0.76 s to 0.82 s; noise optimised from the second frame instead of after the tenth. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polson.Tests.CLI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.MCPServer\Polson.MCPServer.csproj" />
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Workflow templates ship inside the binary, so create-project works from bin/cli with no
         loose files to lose. Resource names become Polson.CLI.ProjectTemplate.<workflow>.<file>. -->
    <EmbeddedResource Include="ProjectTemplate\**\*.md" />
    <!-- The technique catalogue: data the generator, the report and `polson techniques` read. -->
    <EmbeddedResource Include="ProjectTemplate\_shared\techniques.json" />
  </ItemGroup>

  <!-- `bin/cli` is what agent runs use, so it is a Release build: only a Release build is copied there
       (`./build`, or `dotnet build -c Release src/Polson.CLI`). It used to take whichever configuration
       was built last, so every Debug build and test run quietly swapped the agents' CLI for a Debug one,
       and per-pixel motion work runs at about half speed in Debug against a 30 s script limit (a
       full-frame shadow: 30 ms a frame at 720p in Release, 50 in Debug). `-p:CopyToBin=true` copies a
       Debug build anyway, to debug the server an agent is driving.
       Still skippable, because a running agent session holds `bin/cli` open and the copy then fails and
       takes the build with it: `-p:SkipCopyToBin=true`. -->
  <PropertyGroup>
    <CopiesToBin Condition="'$(SkipCopyToBin)' != 'true' And ('$(Configuration)' == 'Release' Or '$(CopyToBin)' == 'true')">true</CopiesToBin>
  </PropertyGroup>

  <!-- Said aloud, at the same importance as the copy's own message: a build that leaves `bin/cli` as it
       was must not read like one that refreshed it. -->
  <Target Name="ReportBinUntouched" AfterTargets="Build" Condition="'$(CopiesToBin)' != 'true' And '$(SkipCopyToBin)' != 'true'">
    <Message Importance="high"
             Text="Polson CLI ($(Configuration)) built; bin\cli left as it was: it holds the Release build agents run. Refresh it with ./build or dotnet build -c Release src/Polson.CLI." />
  </Target>

  <Target Name="CopyOutputToBin" AfterTargets="Build" Condition="'$(CopiesToBin)' == 'true'">
    <ItemGroup>
      <!-- Grab all files in the current project's build output directory -->
      <BuildOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>

    <!-- Copy them to the central solution directory while preserving subfolders -->
    <Copy
      SourceFiles="@(BuildOutputFiles)"
      DestinationFiles="@(BuildOutputFiles->'$(RepoRoot)bin\cli\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      OverwriteReadOnlyFiles="true" />

    <!-- High, not normal: `dotnet build` defaults to minimal verbosity, which prints only high, so
         at normal this line existed and was never once seen — which reads as a build that did not
         run, and cost an afternoon of wondering whether the shipped CLI had the latest changes.
         It names the configuration because that is the part that silently differs: a Debug build
         leaves a Release bin\cli untouched and looks identical from the console. -->
    <Message Importance="high"
             Text="Polson CLI ($(Configuration)) -> $(RepoRoot)bin\cli\" />
  </Target>


</Project>
